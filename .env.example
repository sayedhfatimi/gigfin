# ============================================================
# GigFin environment — copy to .env.local for local development.
#
# Air-gap principle: only the REQUIRED block is needed to run. Every OPTIONAL
# integration is OFF unless its vars are set, and GigFin runs fully offline.
# ============================================================

# --- REQUIRED ---

# Self-hosted Convex backend (the `backend` docker-compose service).
# Used by the Convex CLI to deploy functions.
CONVEX_SELF_HOSTED_URL=http://127.0.0.1:3210
# From: docker compose exec backend ./generate_admin_key.sh
CONVEX_SELF_HOSTED_ADMIN_KEY=

# Public URLs the browser uses (self-hosted: site URL = API port + 1).
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210
NEXT_PUBLIC_CONVEX_SITE_URL=http://127.0.0.1:3211
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Better Auth. Set the SAME two values on the Convex backend as well:
#   npx convex env set SITE_URL http://localhost:3000
#   npx convex env set BETTER_AUTH_SECRET "$(openssl rand -base64 32)"
BETTER_AUTH_SECRET=
SITE_URL=http://localhost:3000

# --- OPTIONAL (omit / leave blank to disable the feature) ---

# Email (password reset + verification) via the Resend Convex component.
# RESEND_API_KEY=

# Privacy-friendly analytics (Rybbit / Plausible / Umami).
# ANALYTICS_SCRIPT_URL=
# ANALYTICS_SITE_ID=

# Lock registration to existing users only (set to "true").
# GIGFIN_DISABLE_SIGNUP=true
