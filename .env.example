# ============================================================
# GigFin environment (docker-compose).
#
# Copy to .env, or just run `sh scripts/setup.sh` (fills the REQUIRED block for you).
# Air-gap principle: only the REQUIRED + per-deployment blocks are needed to run;
# every OPTIONAL integration is OFF unless set, and GigFin runs fully offline.
#
# The internal backend URLs (CONVEX_URL / CONVEX_SITE_URL = http://convex:3210/3211)
# are fixed in docker-compose.yml — you do NOT set them here. For local dev (bun run
# dev) use .env.local with the NEXT_PUBLIC_* values instead.
# ============================================================

# --- REQUIRED (generate once with `sh scripts/setup.sh`) ---

# Session signing secret.            openssl rand -base64 32
BETTER_AUTH_SECRET=
# Pins the Convex backend instance so the admin key stays valid across deploys.
#                                    openssl rand -hex 32
CONVEX_INSTANCE_SECRET=
# Lets the app deploy Convex functions on first boot (minted from the secret above).
CONVEX_SELF_HOSTED_ADMIN_KEY=

# --- PER-DEPLOYMENT (defaults below work for a local single machine) ---

# Where the BROWSER reaches the Convex backend (its cloud port, 3210).
#   Local single box : http://127.0.0.1:3210
#   Private LAN       : http://<lan-ip>:3210
#   Public (e.g.)     : https://convex.gigfin.me
CONVEX_PUBLIC_URL=http://127.0.0.1:3210

# Public URL of the GigFin app itself.
#   Local : http://localhost:3000   LAN : http://<lan-ip>:3000   Public : https://gigfin.me
SITE_URL=http://localhost:3000

# --- OPTIONAL (omit / leave blank to disable the feature) ---

# Email (password reset + verification) via the Resend Convex component.
# RESEND_API_KEY=

# Lock registration to existing users only (set to "true"). Enforced at the
# auth layer (the sign-up endpoint is closed, not just hidden). docker-entrypoint.sh
# pushes this to the Convex backend env; set it on the app service.
# GIGFIN_DISABLE_SIGNUP=true

# Privacy-friendly analytics (Rybbit / Plausible / Umami).
# ANALYTICS_SCRIPT_URL=
# ANALYTICS_SITE_ID=

# External Postgres for the backend instead of the bundled SQLite volume.
# POSTGRES_URL=
