# ============================================================
# GigFin environment.
#
# Air-gap principle: only the REQUIRED block is needed to run. Every OPTIONAL
# integration is OFF unless its vars are set, and GigFin runs fully offline.
#
# For local dev: copy to .env.local and use the NEXT_PUBLIC_* values.
# For docker-compose: copy to .env and use the CONVEX_URL / CONVEX_SITE_URL
# values (read at runtime by the container).
# ============================================================

# --- REQUIRED ---

# Self-hosted Convex backend (the `backend` compose service).
# Generate the admin key once after the backend is up:
#   docker compose up -d backend
#   docker compose exec backend ./generate_admin_key.sh
CONVEX_SELF_HOSTED_URL=http://127.0.0.1:3210
CONVEX_SELF_HOSTED_ADMIN_KEY=

# Browser-reachable backend URLs. Set these to wherever the BROWSER reaches the
# backend (e.g. your domain, or http://127.0.0.1:3210 locally). Site URL = API
# port + 1.
CONVEX_URL=http://127.0.0.1:3210
CONVEX_SITE_URL=http://127.0.0.1:3211

# Public app URL + Better Auth secret. Generate the secret with:
#   openssl rand -base64 32
SITE_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# Host port for the gigfin app container.
GIGFIN_PORT=3000

# --- LOCAL DEV ONLY (.env.local) ---
# NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210
# NEXT_PUBLIC_CONVEX_SITE_URL=http://127.0.0.1:3211
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- OPTIONAL (omit / leave blank to disable the feature) ---

# Email (password reset + verification) via the Resend Convex component.
# RESEND_API_KEY=

# Privacy-friendly analytics (Rybbit / Plausible / Umami).
# ANALYTICS_SCRIPT_URL=
# ANALYTICS_SITE_ID=

# Lock registration to existing users only (set to "true").
# GIGFIN_DISABLE_SIGNUP=true
